# Atlas InternAI - Environment Configuration

# AI & LLM Service
GEMINI_API_KEY=your_gemini_api_key_here
MAX_GEMINI_CALLS_PER_RUN=15
MAX_GEMINI_CALLS_PER_DAY=1500
ENABLE_AI_FALLBACK=true

# Supabase Database & Auth
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_SECRET_KEY=your_supabase_secret_key
SUPABASE_JWKS_URL=https://your-supabase-project.supabase.co/auth/v1/.well-known/jwks.json
DATABASE_URL=postgresql://postgres:your_password@db.your-project.supabase.co:5432/postgres

# Trigger.dev Orchestration
TRIGGER_SECRET_KEY=tr_dev_your_trigger_secret_key

# Notifications (Telegram Bot)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# User Resume & Preferences
USER_RESUME_PATH=./data/resume.pdf

# Pipeline & Rate Limiting
MAX_CONCURRENT_PLUGINS=3
MAX_CONCURRENT_AI=2
RATE_LIMIT_DELAY=2000

# Application System Settings
LOG_LEVEL=INFO
NODE_ENV=development
